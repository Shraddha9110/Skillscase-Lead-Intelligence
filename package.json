{
  "name": "skillcase-lead-intelligence",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "description": "AI-assisted workflow that turns messy Skillcase B2C leads into structured, actionable sales information.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port ${PORT:-3000}",
    "process": "npx tsx scripts/process.ts",
    "test:phase1": "node --import tsx --test phase-1-ingest/ingest.test.ts",
    "test:phase2": "node --import tsx --test phase-2-clean/clean.test.ts",
    "test:phase3": "node --import tsx --test --test-concurrency=1 phase-3-classify/classify.test.ts phase-3-classify/classify.integration.test.ts",
    "test:phase4": "node --import tsx --test phase-4-enrich/enrich.test.ts",
    "test:phase5": "node --import tsx --test phase-5-qc/review.test.ts",
    "test:phase6": "node --import tsx --test phase-6-prioritize/prioritize.test.ts",
    "test:phase7": "node --import tsx --test phase-7-outreach/outreach.test.ts",
    "test:phase8": "node --import tsx --test phase-8-assemble/assemble.test.ts"
  },
  "dependencies": {
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
